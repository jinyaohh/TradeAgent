# TradeAgent Environment Configuration
#
# This file contains all environment variables for the TradeAgent system.
# Copy this file to .env and fill in your actual values.
#
# ⚠️  NEVER commit .env to version control!
# ⚠️  Always use paper trading (testnet/paper=true) before live trading!

# ==========================================
# GENERAL SETTINGS
# ==========================================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL
TZ=America/New_York     # Your timezone

# ==========================================
# PHASE 8: EXCHANGE & BROKER APIs
# ==========================================

# Binance (Cryptocurrency Exchange)
# Phase 8: Real broker integration with automatic fallback to mock
# Get testnet keys from: https://testnet.binance.vision/
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true    # RECOMMENDED: Use testnet for paper trading

# Alpaca (Stock Broker - US Markets)
# Phase 8: Paper and live trading support
# Get free paper trading account: https://alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_PAPER=true       # RECOMMENDED: true for paper trading, false for live
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading URL

# Other Exchanges (Optional - Phase 8 extensible architecture)
# Uncomment and configure if using these exchanges:
# COINBASE_API_KEY=your_coinbase_api_key_here
# COINBASE_API_SECRET=your_coinbase_api_secret_here
# COINBASE_PASSPHRASE=your_coinbase_passphrase_here

# KRAKEN_API_KEY=your_kraken_api_key_here
# KRAKEN_API_SECRET=your_kraken_api_secret_here

# Interactive Brokers (Future expansion)
# IB_ACCOUNT=your_ib_account_here
# IB_HOST=127.0.0.1
# IB_PORT=7497  # 7497 for paper, 7496 for live

# ==========================================
# PHASE 5: NOTIFICATIONS
# ==========================================

# Telegram Notifications (Recommended)
# Setup: Message @BotFather on Telegram, create bot, get token
# Get chat ID: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Notifications (Optional)
# For Gmail: Use App Password, not regular password
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password_here
EMAIL_TO=recipient@example.com

# Webhook Notifications (Optional)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-url.com/alerts

# Console Notifications (Always enabled - for logs)
# No configuration needed - enabled by default

# ==========================================
# PHASE 7: TRADING CONFIGURATION
# ==========================================

# Trading Mode
TRADING_MODE=paper      # ALWAYS start with 'paper' before going live!
CRYPTO_ENABLED=true     # Enable cryptocurrency trading
STOCKS_ENABLED=true     # Enable stock trading

# Initial Capital (for paper trading)
INITIAL_CAPITAL=10000   # Starting capital in USD

# ==========================================
# PHASE 4: RISK MANAGEMENT
# ==========================================

# Position Sizing
POSITION_SIZE_METHOD=risk_pct   # risk_pct, fixed_pct, kelly, atr, fixed_amount
MAX_RISK_PER_TRADE=0.02         # 2% max risk per trade (CONSERVATIVE)
MAX_POSITION_SIZE=0.10          # 10% max capital per position
MIN_POSITION_SIZE=100           # Minimum position size in USD

# Portfolio Limits
MAX_POSITIONS=5                 # Max concurrent positions
MIN_CASH_RESERVE=0.20           # Keep 20% in cash
MAX_PORTFOLIO_RISK=0.10         # 10% max total portfolio risk

# Safety Limits (Circuit Breakers)
DAILY_LOSS_LIMIT=0.05          # 5% daily loss limit - auto-pause trading
MAX_DRAWDOWN=0.15              # 15% max drawdown - emergency stop
MAX_CONSECUTIVE_LOSSES=5        # Stop after 5 consecutive losses

# Stop Loss Settings
DEFAULT_STOP_LOSS=0.02         # 2% default stop loss
STOP_LOSS_TYPE=fixed           # fixed, trailing, atr
TRAILING_STOP_DISTANCE=0.03    # 3% for trailing stops

# Take Profit Settings
DEFAULT_TAKE_PROFIT=0.04       # 4% default take profit
TAKE_PROFIT_TYPE=fixed         # fixed, trailing

# ==========================================
# PHASE 6: BACKTESTING
# ==========================================

# Backtest Parameters
BACKTEST_ENABLED=true
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
BACKTEST_INITIAL_CAPITAL=10000

# Backtest Costs
BACKTEST_COMMISSION=0.001      # 0.1% commission per trade
BACKTEST_SLIPPAGE=0.0005       # 0.05% slippage

# Walk-Forward Analysis
WALKFORWARD_ENABLED=true
WALKFORWARD_TRAIN_PERIOD=180   # Days for training
WALKFORWARD_TEST_PERIOD=60     # Days for testing

# Monte Carlo Simulation
MONTE_CARLO_SIMULATIONS=1000   # Number of simulations
MONTE_CARLO_CONFIDENCE=0.95    # 95% confidence level

# ==========================================
# PHASE 5: DASHBOARD
# ==========================================

DASHBOARD_ENABLED=true
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8501
DASHBOARD_AUTO_REFRESH=60      # Auto-refresh interval in seconds

# ==========================================
# DATABASE (Optional - for persistence)
# ==========================================

# SQLite (Development - default)
DATABASE_URL=sqlite:///data/tradeagent.db

# PostgreSQL (Production - optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/tradeagent

# ==========================================
# EXCHANGE CONNECTION SETTINGS
# ==========================================

# Connection Health Monitoring (Phase 8)
HEALTH_CHECK_INTERVAL=60       # Health check every 60 seconds
HEALTH_CHECK_TIMEOUT=10        # Timeout after 10 seconds
MAX_RECONNECT_ATTEMPTS=3       # Try reconnecting 3 times
RECONNECT_DELAY=5              # Wait 5 seconds between reconnects

# API Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_MAX_REQUESTS_PER_MINUTE=60
API_RETRY_ON_LIMIT=true

# Data Caching
CACHE_ENABLED=true
CACHE_TTL=300                  # Cache for 5 minutes (300 seconds)

# ==========================================
# STRATEGY CONFIGURATION
# ==========================================

# Default Strategy
DEFAULT_CRYPTO_STRATEGY=rsi    # rsi, ma_crossover, momentum
DEFAULT_STOCK_STRATEGY=rsi     # rsi, ma_crossover, momentum

# Strategy Parameters (can be overridden in config/strategies.yaml)
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

MA_FAST_PERIOD=10
MA_SLOW_PERIOD=30

# Trading Intervals
CRYPTO_CHECK_INTERVAL=300      # Check crypto signals every 5 minutes
STOCK_CHECK_INTERVAL=300       # Check stock signals every 5 minutes

# ==========================================
# PERFORMANCE & OPTIMIZATION
# ==========================================

# Multi-threading (Phase 7)
WORKERS=4                      # Number of worker threads
MAX_CONCURRENT_ORDERS=3        # Max orders to process simultaneously

# Data Processing
MAX_BARS_TO_LOAD=1000         # Max historical bars to load
DATA_COMPRESSION=true          # Compress data in memory

# ==========================================
# LOGGING & DEBUGGING
# ==========================================

# Log Settings
LOG_FILE=logs/tradeagent.log
LOG_MAX_BYTES=10485760        # 10MB max log file size
LOG_BACKUP_COUNT=5            # Keep 5 backup log files
LOG_FORMAT=detailed           # simple, detailed, json

# Debugging
DEBUG_MODE=false              # Enable debug mode
VERBOSE_LOGGING=false         # Verbose logging (very detailed)
LOG_TRADES_TO_FILE=true       # Log all trades to separate file
TRADE_LOG_FILE=logs/trades.log

# ==========================================
# DEVELOPER SETTINGS
# ==========================================

# Development Mode
DEV_MODE=false                # Enable development features
MOCK_TRADING=false            # Use mock exchange connectors
DISABLE_REAL_ORDERS=false     # Simulate orders without executing

# Testing
RUN_INTEGRATION_TESTS=false   # Run integration tests on startup
SKIP_HEALTH_CHECKS=false      # Skip exchange health checks

# Paths (usually don't need to change)
# CONFIG_PATH=config/
# STRATEGY_PATH=strategies/
# DATA_PATH=data/
# LOG_PATH=logs/

# ==========================================
# SECURITY SETTINGS
# ==========================================

# API Security
API_KEY_ENCRYPTION=false      # Encrypt API keys (requires setup)
USE_IP_WHITELIST=false        # Whitelist IPs for API access
ALLOWED_IPS=127.0.0.1         # Comma-separated IPs

# Session Security
SESSION_TIMEOUT=3600          # Session timeout in seconds
REQUIRE_AUTH=false            # Require authentication for dashboard

# ==========================================
# OPTIONAL: ADVANCED FEATURES
# ==========================================

# Machine Learning (Future)
# ML_ENABLED=false
# ML_MODEL_PATH=models/

# Options Trading (Future)
# OPTIONS_ENABLED=false

# Futures Trading (Future)
# FUTURES_ENABLED=false

# Multi-Account (Future)
# MULTI_ACCOUNT_ENABLED=false

# ==========================================
# NOTES
# ==========================================
#
# Quick Start:
# 1. Copy this file: cp .env.example .env
# 2. Get Binance testnet keys: https://testnet.binance.vision/
# 3. Get Alpaca paper keys: https://alpaca.markets/
# 4. Set up Telegram bot (optional): @BotFather
# 5. Keep BINANCE_TESTNET=true and ALPACA_PAPER=true
# 6. Start with: python main.py start
#
# Safety Checklist:
# ✓ BINANCE_TESTNET=true (use testnet)
# ✓ ALPACA_PAPER=true (use paper trading)
# ✓ TRADING_MODE=paper (paper trading mode)
# ✓ MAX_RISK_PER_TRADE=0.02 (conservative 2%)
# ✓ DAILY_LOSS_LIMIT=0.05 (5% circuit breaker)
# ✓ Run for 30+ days in paper mode before live
#
# Documentation:
# - Quick Start: docs/QUICKSTART.md
# - User Manual: docs/USER_MANUAL.md
# - Developer Guide: docs/CLAUDE.md
#
