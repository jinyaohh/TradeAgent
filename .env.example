# TradeAgent Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==========================================
# GENERAL SETTINGS
# ==========================================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR, CRITICAL
TZ=America/New_York     # Your timezone

# ==========================================
# CRYPTO EXCHANGE APIs
# ==========================================

# Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true    # Use testnet for testing

# Coinbase Pro
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here

# Kraken
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_API_SECRET=your_kraken_api_secret_here

# ==========================================
# STOCK BROKER APIs
# ==========================================

# Alpaca
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_PAPER=true       # true for paper trading, false for live
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading URL

# Interactive Brokers (future)
# IB_ACCOUNT=your_ib_account_here
# IB_HOST=127.0.0.1
# IB_PORT=7497  # 7497 for paper, 7496 for live

# ==========================================
# NOTIFICATIONS
# ==========================================

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=true

# Email (optional)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=your_email@example.com
EMAIL_TO=your_email@example.com
EMAIL_PASSWORD=your_email_app_password_here

# Webhook (optional)
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://your-webhook-url.com/alerts

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=sqlite:///tradeagent.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/tradeagent

# ==========================================
# TRADING SETTINGS
# ==========================================
TRADING_MODE=paper      # paper, live
CRYPTO_ENABLED=true
STOCKS_ENABLED=true

# Risk Management
MAX_RISK_PER_TRADE=0.02        # 2% max risk per trade
MAX_PORTFOLIO_RISK=0.10        # 10% max total portfolio risk
MAX_POSITIONS=5                 # Max concurrent positions
DAILY_LOSS_LIMIT=0.05          # 5% daily loss limit
MAX_DRAWDOWN=0.15              # 15% max drawdown before emergency stop

# Position Sizing
POSITION_SIZE_METHOD=risk_pct   # risk_pct, fixed_pct, kelly
MIN_POSITION_SIZE=100          # Minimum position size in USD

# ==========================================
# BACKTESTING
# ==========================================
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
BACKTEST_INITIAL_CAPITAL=10000

# ==========================================
# DASHBOARD
# ==========================================
DASHBOARD_PORT=8501
DASHBOARD_HOST=localhost

# ==========================================
# ADVANCED SETTINGS
# ==========================================

# API Rate Limiting
API_RATE_LIMIT_ENABLED=true
API_MAX_REQUESTS_PER_MINUTE=60

# Data Caching
CACHE_ENABLED=true
CACHE_TTL=300  # seconds

# Performance
WORKERS=4
MAX_CONCURRENT_ORDERS=3

# Debugging
DEBUG_MODE=false
VERBOSE_LOGGING=false

# ==========================================
# DEVELOPER SETTINGS
# ==========================================
# Uncomment for development
# FREQTRADE_CONFIG_PATH=freqtrade_config/config.json
# STRATEGY_PATH=strategies/
